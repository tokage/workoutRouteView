{
  "name": "workout-route-view",
  "private": true,
  "version": "0.1.0",
  "description": "Local Apple Health outdoor workout route viewer built with React and Leaflet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamXP2004/workoutRouteView.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && rm -rf ../web && cp -R dist ../web",
    "build:private": "vite build --mode private",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:js",
    "test:js": "node --test",
    "typecheck": "tsc --noEmit",
    "privacy-check": "python3 scripts/check_privacy.py",
    "check:i18n": "node scripts/check_i18n_keys.mjs",
    "check": "node scripts/check_i18n_keys.mjs && npm run test && npm run typecheck && npm run build && npm run privacy-check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "i18next": "26.3.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "17.0.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^6.0.5"
  }
}
